<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI Chat Box</title>
  <style>
    /* ==== CSS Variables ==== */
    :root {
      --bg: #0d0d0d;
      --bg-card: #1a1a1a;
      --fg: #e0e0e0;
      --muted: #6b6b6b;
      --accent: #00d4aa;
      --border: #2a2a2a;
    }

    /* ==== Reset ==== */
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: system-ui, -apple-system, sans-serif;
      background: var(--bg);
      color: var(--fg);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1rem;
    }

    /* ==== Chat Container ==== */
    .chat-box {
      width: 100%;
      max-width: 600px;
      background: var(--bg-card);
      border-radius: 16px;
      overflow: hidden;
      border: 1px solid var(--border);
    }

    /* ==== Header ==== */
    .header {
      padding: 0.875rem 1rem;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .header h1 {
      font-size: 0.875rem;
      font-weight: 600;
      letter-spacing: -0.2px;
    }

    .header span {
      font-size: 0.625rem;
      color: var(--muted);
    }

    /* ==== Messages ==== */
    .messages {
      flex: 1;
      padding: 1rem;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 0.625rem;
    }

    .message {
      max-width: 80%;
      padding: 0.5rem 0.75rem;
      border-radius: 12px;
      font-size: 0.8125rem;
      line-height: 1.4;
      position: relative;
    }

    .message.user {
      align-self: flex-end;
      background: var(--accent);
      color: #000;
    }

    .message.ai {
      align-self: flex-start;
      background: #111;
      border: 1px solid var(--border);
    }

    .timestamp {
      font-size: 0.5625rem;
      opacity: 0.6;
      margin-top: 0.125rem;
      text-align: right;
    }

    .message.ai .timestamp { text-align: left; }

    /* ==== Input Area ==== */
    .input-area {
      padding: 0.625rem 1rem;
      border-top: 1px solid var(--border);
      display: flex;
      gap: 0.5rem;
      align-items: center;
    }

    .input-area input {
      flex: 1;
      background: #000;
      border: none;
      border-radius: 20px;
      padding: 0.4375rem 0.625rem;
      color: var(--fg);
      font-size: 0.8125rem;
      outline: none;
    }

    .input-area button {
      background: var(--accent);
      border: none;
      border-radius: 50%;
      width: 32px;
      height: 32px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.12s;
    }

    .input-area button:hover {
      background: #00f0c0;
    }

    .input-area button svg {
      width: 16px;
      height: 16px;
      fill: #000;
    }

    .hint {
      text-align: center;
      font-size: 0.5625rem;
      color: var(--muted);
      margin-top: 0.375rem;
    }

    @media (max-width: 400px) {
      .chat-box { margin: 0.5rem; border-radius: 14px; }
      .message { max-width: 85%; }
    }
  </style>
</head>

<body>

<div class="chat-box">
  <div class="header">
    <h1>AI Assistant</h1>
    <span>v1.0</span>
  </div>

  <div class="messages" id="messages">
    <div class="message ai">Hello! How can I help you today?</div>
  </div>

  <div class="input-area">
    <input type="text" id="userInput" placeholder="Type a message…" autocomplete="off">
    <button id="sendBtn" aria-label="Send">
      <svg viewBox="0 0 24 24"><path d="M2.01 21L23 12 2.01 3zM12 3L2 12h4v8L12 21l8-3-8-3-8 3v-8h4z"/></svg>
    </button>
  </div>
</div>

<script>
  const messages = document.getElementById('messages');
  const input    = document.getElementById('userInput');
  const sendBtn  = document.getElementById('sendBtn');

  function addMessage(text, isUser = false) {
    const div = document.createElement('div');
    div.className = `message ${isUser ? 'user' : 'ai'}`;
    div.textContent = text;
    messages.appendChild(div);
    messages.scrollTop = messages.scrollHeight;
  }

  function getAIResponse(userText) {
    const lower = userText.toLowerCase().trim();
    if (lower.includes('hello') || lower.includes('hi')) return 'Hello! How can I help you?';
    if (lower.includes('how are you')) return 'I\'m doing well, thanks!';
    if (lower.includes('time')) return `It's ${new Date().toLocaleTimeString()}`;
    if (lower.includes('help')) return 'I can answer basic questions or just chat.';
    if (lower === '') return 'Please type a message.';
    return 'Interesting! Tell me more about that.';
  }

  function sendMessage() {
    const text = input.value.trim();
    if (!text) return;
    input.value = '';
    addMessage(text, true);
    addMessage(getAIResponse(text), false);
  }

  // Events
  sendBtn.addEventListener('click', sendMessage);
  input.addEventListener('keypress', e => {
    if (e.key === 'Enter' && !e.shiftKey) sendMessage();
  });

  // Focus on load
  setTimeout(() => input.focus(), 300);
</script>

</body>
</html>
